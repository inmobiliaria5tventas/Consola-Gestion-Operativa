<!DOCTYPE html>
<html lang="es">
<head>
  <!-- ����������������������������������������������������������������������������������������������������������������
       5 TIERRAS � CRM & GIS Unificado
       SPA Shell · v1.0.0
       ���������������������������������������������������������������������������������������������������������������� -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#0a0e1a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="description" content="5 Tierras � CRM & GIS Unificado para gestión inmobiliaria de parcelas">

  <title>5 TIERRAS � CRM &amp; GIS Unificado</title>

  <!-- Google Fonts: Inter + Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Font Awesome 6.5.1 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">

  <!-- Leaflet 1.9.4 CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="">

  <!-- App Design System -->
  <link rel="stylesheet" href="index.css?v=1.8.6">
  <!-- Tailwind CSS CDN for Login and Settings Panel -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    window.tailwind.config = {
      corePlugins: {
        preflight: false,
      }
    }
  </script>
  <!-- Inline Safeguard to trigger database auto-healing if properties are empty or lack coordinates -->
  <script>
    try {
      var props = localStorage.getItem('app5t_propiedades');
      if (!props || JSON.parse(props).length === 0 || !JSON.parse(props).some(function(p) { return p.coordenadas; })) {
        localStorage.removeItem('app5t_db_version');
      }
    } catch(e) {}
  </script>
</head>

<body>
  <!-- ================================================================
       LOGIN CONTAINER (Zero-Trust Security overlay)
       ================================================================ -->
  <div id="login-container" class="fixed inset-0 z-[99999] flex items-center justify-center bg-[#0a0e1a]/95 backdrop-blur-md transition-all duration-300">
    <div class="w-full max-w-md p-8 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl shadow-2xl flex flex-col items-center">
      
      <!-- Brand Logo & Header -->
      <div class="flex items-center gap-3 mb-8">
        <img src="../04_RECURSOS/logo5t.png?v=1.1.9" alt="5T Logo" class="w-12 h-12 object-contain">
        <div>
          <h2 class="text-2xl font-extrabold tracking-wide text-white leading-tight font-['Outfit'] m-0">5 TIERRAS</h2>
          <p class="text-[10px] text-purple-400 font-semibold uppercase tracking-widest leading-none m-0">Consola de Gestión</p>
        </div>
      </div>
      
      <!-- Form -->
      <form id="login-form" class="w-full flex flex-col gap-5 m-0">
        <div class="flex flex-col gap-2">
          <label for="login-rut" class="text-xs font-semibold text-slate-400 uppercase tracking-wider">RUT Usuario</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500">
              <i class="fa-solid fa-address-card"></i>
            </span>
            <input type="text" id="login-rut" placeholder="12.345.678-9" required
                   class="w-full pl-10 pr-4 py-3 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all font-medium text-sm">
          </div>
        </div>
        
        <div class="flex flex-col gap-2">
          <label for="login-password" class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Contraseña</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500">
              <i class="fa-solid fa-lock"></i>
            </span>
            <input type="password" id="login-password" placeholder="⬢⬢⬢⬢⬢⬢⬢⬢" required
                   class="w-full pl-10 pr-4 py-3 bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all text-sm">
          </div>
        </div>
        
        <button type="submit" id="btn-login-submit"
                class="w-full py-3 mt-4 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold rounded-xl shadow-lg shadow-purple-600/20 hover:from-purple-500 hover:to-indigo-500 focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all flex items-center justify-center gap-2 cursor-pointer border-0 outline-none text-sm">
          <i class="fa-solid fa-right-to-bracket"></i> Ingresar
        </button>
      </form>
      
      <!-- Footer Info -->
      <p class="text-center text-[10px] text-slate-600 mt-8 mb-0">
        Sistema de Seguridad Zero-Trust · 5 Tierras &copy; 2026
      </p>
    </div>
  </div>

  <!-- ================================================================
       APP LAYOUT CONTAINER
       ================================================================ -->
  <div class="app-layout" id="app-layout" style="display: none;">

    <!-- ������������������������������������������������������������������������������������������������������������
         MOBILE: Hamburger Button
         ������������������������������������������������������������������������������������������������������������ -->
    <button class="hamburger-btn" id="hamburger-btn" aria-label="Abrir menú">
      <i class="fa-solid fa-bars"></i>
    </button>
    
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- �"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"�
         SIDEBAR
         �"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"� -->
    <aside class="sidebar" id="sidebar">

      <!-- Brand -->
      <div class="sidebar-brand">
        <img src="../04_RECURSOS/logo5t.png?v=1.1.9" alt="5T" class="brand-logo">
        <div>
          <h1 class="brand-title">5 TIERRAS</h1>
          <p class="brand-subtitle">Gestión operativa</p>
        </div>
      </div>

      <!-- Navigation (populated by JS based on role) -->
      <nav class="sidebar-nav" id="sidebar-nav">
        <!-- Menu items injected by JS -->
      </nav>

      <!-- Footer: Copyright -->
      <div class="sidebar-footer">
        <p class="footer-text">5 Tierras &copy; 2026</p>
      </div>

    <!-- """"""""""""""""""""""""""""""""""""""""""""""""""""""
         MAIN CONTENT AREA
         """""""""""""""""""""""""""""""""""""""""""""""""""""" -->
    <main class="main-content">

      <!--    App Header    -->
      <header class="app-header">
        <div class="header-breadcrumbs">
          <span id="breadcrumb-parent">Consola</span>
          <span class="separator">/</span>
          <span id="breadcrumb-current" class="active">Dashboard</span>
        </div>

        <!-- Role Selector Buttons (Hidden for Production Auth) -->
        <div class="role-btn-group" id="role-btn-group" style="display: none;">
          <button class="role-btn" data-role="vendedor"><i class="fa-solid fa-user-tag"></i> <span>Ventas</span></button>
          <button class="role-btn" data-role="gerente"><i class="fa-solid fa-user-tie"></i> <span>Gerencia</span></button>
          <button class="role-btn" data-role="administrador"><i class="fa-solid fa-scale-balanced"></i> <span>Administración</span></button>
        </div>

        <div class="header-right" style="display:flex; align-items:center; gap: 16px;">
          <div class="header-actions" style="display:flex; align-items:center; gap: 16px;">
            <div class="sync-status" id="sync-status" style="display: flex; align-items: center; gap: 6px;">
              <span class="sync-dot online" id="sync-dot"></span>
              <span class="sync-text" id="sync-text" style="color: var(--text-muted); font-size: 0.85rem;">Conectado</span>
            </div>
            <!-- Funnel Button (Only visible on map mobile) -->
            <button id="map-filter-toggle" class="map-filter-toggle-btn" onclick="document.getElementById('map-controls-panel').classList.toggle('expanded')" title="Filtros del Mapa" style="background: transparent; border: none; font-size: 1.25rem; color: var(--text-muted); cursor: pointer;">
              <i class="fa-solid fa-filter"></i>
            </button>

            <!-- Notification Bell -->
            <div class="notification-bell" id="btn-notifications" title="Mis Solicitudes Pendientes" style="position:relative; cursor:pointer; color:var(--text-muted); font-size: 1.25rem; transition:color 0.2s;" onmouseover="this.style.color='var(--text-light)';" onmouseout="this.style.color='var(--text-muted)';">
              <i class="fa-regular fa-bell"></i>
              <span id="notification-badge" class="badge" style="display:none; position:absolute; top:-6px; right:-8px; background:var(--accent-red); color:white; font-size:0.65rem; padding: 2px 5px; border-radius:10px; font-weight:bold; border: 2px solid var(--bg-dark);">0</span>
            </div>
          </div>

          <div class="user-profile" style="display:flex; align-items:center; gap:12px;">
            <div class="profile-info">
              <span id="user-name" class="profile-name">Usuario</span>
              <span id="user-role" class="profile-role">Vendedor</span>
            </div>
            <div class="profile-avatar" id="btn-logout" aria-label="Cerrar Sesión" title="Cerrar Sesión" style="cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.15)'; this.style.color='#ef4444';" onmouseout="this.style.background=''; this.style.color='';">
              <i class="fa-solid fa-user"></i>
            </div>
          </div>
        </div>
      </header>

      <!-- Mobile Category Chips (horizontal scroll) -->
      <div class="mobile-chips-bar" id="mobile-chips-bar"></div>

      <!-- �"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"�
           TAB CONTAINER � All Panels
           �"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"��"� -->
      <div class="tab-container" id="tab-container">

        <!-- ������������������������������������������������������������������������������������������������
             TAB: Dashboard
             ������������������������������������������������������������������������������������������������ -->
        <div class="tab-panel" id="panel-dashboard">

          <!-- Título Dashboard Gerencia -->
          <div class="dashboard-gerencia-header role-chart role-gerente" style="display:none; margin-bottom: 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
              <h2 style="font-size: 24px; font-weight: 700; color: #1e293b; margin: 0;">RESUMEN COMERCIAL</h2>
              <button onclick="APP5T_Charts.exportChartReport('panel-dashboard', 'Resumen_Comercial_Completo')" style="background-color: #e74c3c; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 600; display:flex; align-items:center; gap:8px; box-shadow: 0 4px 6px rgba(231, 76, 60, 0.2); transition: background 0.2s;" onmouseover="this.style.backgroundColor='#c0392b';" onmouseout="this.style.backgroundColor='#e74c3c';" title="Descargar Informe Completo PDF">
                <i class="fa-solid fa-file-pdf"></i> Descargar PDF
              </button>
            </div>
          </div>

          <!-- KPI Cards (populated by JS) -->
          <div class="kpi-grid" id="kpi-grid">
            <!-- .kpi-card elements injected dynamically -->
          </div>

          <!-- ==========================================
               NUEVO LAYOUT GERENCIA (CSS Grid)
               ========================================== -->
          <div class="dashboard-gerencia-layout role-chart role-gerente" style="display:none;">
            
            <!-- Fila 2: Embudo (Izquierda) + Paneles (Derecha) -->
            <div class="gerencia-grid-row-2">
              <div class="chart-card gerencia-embudo">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                  <h3 class="chart-title" style="margin-bottom:0; text-transform:uppercase; font-size:12px; color:#555;">Embudo de Ventas</h3>
                  
                </div>
                <div class="chart-wrapper">
                  <canvas id="chart-embudo-ventas"></canvas>
                </div>
              </div>

              <div class="chart-card">
                <h3 class="chart-title">Avance por Etapa</h3>
                <div id="avance-etapa-container" style="margin-top:20px; display:flex; flex-direction:column; gap:15px;">
                  <!-- Injected via JS -->
                </div>
              </div>
            </div>

          <!-- Gerencia Row 4 -->
          <div class="charts-row gerencia-grid-row-4 role-chart role-gerente" style="display:none; margin-bottom:20px;">
              <div class="chart-card">
                <h3 class="chart-title">Nivel de Morosidad</h3>
                <div class="chart-wrapper" style="height: 250px;">
                  <canvas id="chart-morosidad-gerencia"></canvas>
                </div>
              </div>

              <div class="chart-card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                  <h3 class="chart-title" style="margin-bottom:0;">Cobranza del Mes</h3>
                  <select id="filter-cobranza-project-gerencia" class="form-select" style="width:150px; padding:4px 8px; font-size:12px;" onchange="APP5T_Charts.updateCobranzaFilter(this.value, 'chart-cobranza-mes-gerencia')">
                    <option value="all">Todos</option>
                  </select>
                </div>
                <div class="chart-wrapper" style="height: 250px;">
                  <canvas id="chart-cobranza-mes-gerencia"></canvas>
                </div>
              </div>

              <div class="chart-card">
                <h3 class="chart-title">Proyección Flujo de Caja</h3>
                <div class="chart-wrapper" style="height: 250px;">
                  <canvas id="chart-cashflow-gerencia"></canvas>
                </div>
              </div>
            </div>

          </div>
          <!-- ========================================== -->

          <!-- Charts Row Admin -->
          <div class="charts-row role-chart role-administrador" id="charts-row-admin-1" style="display:none;">
            <div class="chart-card">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h3 class="chart-title" style="margin-bottom:0;">Composición del Inventario</h3>
                <select id="filter-composition-project" class="form-select" style="width:150px; padding:4px 8px; font-size:12px;" onchange="APP5T_Charts.updateCompositionFilter(this.value)">
                  <option value="all">Todos</option>
                </select>
              </div>
              <div class="chart-wrapper">
                <canvas id="chart-composition"></canvas>
              </div>
            </div>
            <div class="chart-card">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h3 class="chart-title" style="margin-bottom:0;">Cobranza del Mes</h3>
                <select id="filter-cobranza-project" class="form-select" style="width:150px; padding:4px 8px; font-size:12px;" onchange="APP5T_Charts.updateCobranzaFilter(this.value, 'chart-cobranza-mes')">
                  <option value="all">Todos</option>
                </select>
              </div>
              <div class="chart-wrapper">
                <canvas id="chart-cobranza-mes"></canvas>
              </div>
            </div>
          </div>
          
          <!-- Panel Alertas Admin -->
          <div class="data-card role-chart role-administrador" id="card-alertas-admin" style="margin-top:20px;display:none;">
            <h3 class="card-title" style="margin:0;color:#e74c3c;"><i class="fa-solid fa-triangle-exclamation"></i> Próximos Vencimientos (30 días)</h3>
            <div class="table-responsive" style="margin-top:14px;">
              <div id="chart-alertas-admin-panel"></div>
            </div>
          </div>

          <!-- Charts Row Vendedor -->
          <div class="charts-row role-chart role-vendedor" id="charts-row-vendedor-1" style="display:none;">
            <div class="chart-card">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h3 class="chart-title" style="margin-bottom:0;">Mi Embudo de Ventas</h3>
                
              </div>
              </div></div><div class="chart-card">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h3 class="chart-title" style="margin-bottom:0;">Mi Meta Personal</h3>
                
              </div>
              <div class="chart-wrapper">
                <canvas id="chart-meta-personal"></canvas>
              </div>
            </div>
          </div>

          <!-- Panel Alertas Vendedor -->
          <div class="data-card role-chart role-vendedor" id="card-alertas-vendedor" style="margin-top:20px;display:none;">
            <h3 class="card-title" style="margin:0;color:#e74c3c;"><i class="fa-solid fa-triangle-exclamation"></i> Alertas de Reservas por Vencer</h3>
            <div class="table-responsive" style="margin-top:14px;">
              <div id="chart-alertas-vendedor-panel"></div>
            </div>
          </div>

          <!-- Rentability Panel removed as requested -->

          
        </div>

        <!-- ������������������������������������������������������������������������������������������������
             TAB: Mapa GIS
                                                              -->
        <div class="tab-panel active" id="panel-mapa">

          <!-- Map Filters Bar -->
          <div class="map-controls" id="map-controls-panel">
            <div class="control-group" id="map-project-filter-group">
              <label><i class="fa-solid fa-map-location-dot"></i> Proyecto</label>
              <select id="map-project-filter" class="control-select">
                <option value="todos">Todos los Proyectos</option>
                <!-- Opciones dinámicas inyectadas por JS -->
              </select>
            </div>
            <div class="control-group" id="map-status-filter-group">
              <label><i class="fa-solid fa-filter"></i> Estado</label>
              <select id="map-status-filter" class="control-select">
                <option value="todos">Todos</option>
                <option value="Disponible">Disponible</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Reservada">Reservada</option>
                <option value="Promesada">Promesada</option>
                <option value="Vendida">Vendida</option>
              </select>
            </div>
          </div>

          <!-- GIS Layout: Map + Panel -->
          <div class="gis-layout">

            <!-- Map -->
            <div class="map-container">
              <div id="map-element" class="map-element"></div>
            </div>

            <!-- Desktop: Lote Detail Panel -->
            <div class="lote-panel" id="lote-panel">
              <!-- Empty state (default) -->
              <div class="empty-state" id="lote-empty">
                <i class="fa-solid fa-map-pin bounce"></i>
                <h3>Selecciona un Lote</h3>
                <p>Haz clic en una parcela del mapa para interactuar.</p>
              </div>
              <!-- Lote details (hidden until selection) -->
              <div id="lote-details" style="display:none">
                <div class="lote-header">
                  <div>
                    <h2 id="lote-title" class="lote-title">Lote --</h2>
                    <span id="lote-project" class="lote-project">--</span>
                  </div>
                  <span id="lote-status-badge" class="status-badge">--</span>
                </div>
                <div class="lote-specs">
                  <div class="spec">
                    <span class="spec-label">Superficie</span>
                    <span id="lote-area" class="spec-value">--</span>
                  </div>
                  <div class="spec">
                    <span class="spec-label">Precio Lista</span>
                    <span id="lote-price" class="spec-value">--</span>
                  </div>

                </div>
                <hr class="divider">
                <div id="lote-action-form">
                  <!-- Dynamic action form injected by JS based on role/status -->
                </div>
              </div>
            </div>

            <!-- Mobile: Bottom Sheet -->
            <div class="bottom-sheet" id="bottom-sheet">
              <button class="bottom-sheet-close" id="bottom-sheet-close" aria-label="Cerrar detalles">
                <i class="fa-solid fa-xmark"></i>
              </button>
              <div class="bottom-sheet-handle" id="bottom-sheet-handle">
                <div class="handle-bar"></div>
              </div>
              <div class="bottom-sheet-content" id="bottom-sheet-content">
                <!-- Content cloned/managed by JS -->
              </div>
            </div>
          </div>
        </div>

        <!-- ������������������������������������������������������������������������������������������������
             TAB: Mis Leads (Vendedor)
