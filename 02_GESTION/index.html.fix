                <thead>
                  <tr>
                    <th>Lote</th>
                    <th>Proyecto</th>
                    <th>Superficie</th>
                    <th>Precio</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody id="tbody-inventario">
                  <!-- Rows injected by JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ������������������������������������������������������������������������������������������������
             TAB: Auditoría
             ������������������������������������������������������������������������������������������������ -->
        <div class="tab-panel" id="panel-auditoria">
          <div class="data-card">
            <h3 class="card-title">Registro de Auditoría</h3>
            <p class="card-subtitle">Log cronológico de acciones del sistema</p>
            <div class="table-responsive">
              <table class="premium-table">
                <thead>
                  <tr>
                    <th>Fecha / Hora</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Tabla</th>
                    <th>Detalles</th>
                  </tr>
                </thead>
                <tbody id="tbody-auditoria">
                  <!-- Rows injected by JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ������������������������������������������������������������������������������������������������
             TAB: Configuración del Sistema (Administrador)
             ������������������������������������������������������������������������������������������������ -->
        <div class="tab-panel" id="panel-admin-general">
          
          <!-- Sub-tabs header for administrator panel -->
          <div style="display: flex; gap: 15px; border-bottom: 1px solid var(--glass-border); margin-bottom: 24px; padding-bottom: 1px;">
            <button class="settings-subtab active" id="btn-settings-perms" style="background: transparent; border: none; border-bottom: 3px solid var(--primary); color: var(--text-white); padding: 12px 18px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-family: 'Inter', sans-serif;">
              <i class="fa-solid fa-shield-halved" style="color: var(--primary);"></i> Matriz de Permisos
            </button>
            <button class="settings-subtab" id="btn-settings-users" style="background: transparent; border: none; border-bottom: 3px solid transparent; color: var(--text-dim); padding: 12px 18px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-family: 'Inter', sans-serif;" onmouseover="this.style.color='var(--text-white)'" onmouseout="if(!this.classList.contains('active')) this.style.color='var(--text-dim)'">
              <i class="fa-solid fa-users-gear"></i> Gestión de Usuarios
            </button>
          </div>

          <!-- Sub-panel 1: Permissions Matrix -->
          <div id="settings-perms-content">
            <div class="data-card">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 20px;">
                <div>
                  <h3 class="card-title"><i class="fa-solid fa-matrix"></i> Matriz de Gobernanza Dinámica</h3>
                  <p class="card-subtitle">Controla en tiempo real qué módulos visuales y de negocio puede ver cada rol.</p>
                </div>
                <button id="btn-save-permissions" class="btn btn-success" style="padding: 10px 18px; font-weight: 600; display: flex; align-items: center; gap: 8px; cursor: pointer;">
                  <i class="fa-solid fa-cloud-arrow-up"></i> Guardar en servidor
                </button>
              </div>

              <div class="table-responsive">
                <table class="premium-table">
                  <thead>
                    <tr>
                      <th>Componente / Módulo</th>
                      <th>Descripción</th>
                      <th style="text-align: center; width: 120px;">Vendedor</th>
                      <th style="text-align: center; width: 120px;">Gerencia</th>
                      <th style="text-align: center; width: 120px;">Administración</th>
                    </tr>
                  </thead>
                  <tbody id="tbody-permissions-matrix">
                    <!-- Rows loaded from 00_Gobernanza_Permisos in Sheets -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Sub-panel 2: User Accounts Management -->
          <div id="settings-users-content" style="display: none;">
            <div class="data-card">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 20px;">
                <div>
                  <h3 class="card-title"><i class="fa-solid fa-user-lock"></i> Gestión de Usuarios del Ecosistema</h3>
                  <p class="card-subtitle">Crea, edita o bloquea el acceso de vendedores, directores y administradores.</p>
                </div>
                <button id="btn-add-user" class="btn btn-primary" style="padding: 10px 18px; font-weight: 600; display: flex; align-items: center; gap: 8px; cursor: pointer;">
                  <i class="fa-solid fa-user-plus"></i> Agregar Nuevo Usuario
                </button>
              </div>

              <div class="table-responsive">
                <table class="premium-table">
                  <thead>
                    <tr>
                      <th>RUT Usuario</th>
                      <th>Nombre Completo</th>
                      <th>Rol Asignado</th>
                      <th>Estado</th>
                      <th style="text-align: right; width: 180px;">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="tbody-users-list">
                    <!-- Rows loaded from 00_Usuarios in Sheets -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>

      </div><!-- /tab-container -->
    </main>

    <!-- Mobile Bottom Navigation Bar -->
    <div class="mobile-nav-bar" id="mobile-nav-bar"></div>
  </div><!-- /app-layout -->


